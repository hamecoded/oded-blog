# oded.me — build settings. Copy to .env (git-ignored) and fill in, or run `npm run setup`.
#
# Every value here is read at BUILD time and ends up in the public JavaScript, so only
# public values belong here. Never put the Supabase secret / service_role key in this file.
# After changing a value, restart `npm run dev` or rebuild and redeploy.

# ── Supabase (required for a live site) ──────────────────────────────
# Leave both empty to run in demo mode: data is stored only in each visitor's browser.
# Supabase Dashboard → Project Settings → API Keys.
# Example: https://abcd1234.supabase.co
VITE_SUPABASE_URL=
# The publishable key (sb_publishable_…) or the legacy anon key (eyJhbGci…).
VITE_SUPABASE_ANON_KEY=

# ── YouTube uploads (optional) ───────────────────────────────────────
# Google Cloud OAuth client ID (type "Web application"). See README §8.5.
# Example: 1234567890-abc123def456.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=

# ── Sign in with Google … (optional) ─────────────────────────────────
# Buttons shown below the email form, in this order: google, facebook, apple, github.
# Default (empty): google. Set to "none" for email only. Facebook needs a Live Meta app,
# which requires Meta business verification (README §8.1 step 5).
# Each one must also be switched on in Supabase → Authentication → Sign In / Providers (README §8.1).
VITE_OAUTH_PROVIDERS=

# ── Bot check on sign-up and sign-in (optional) ──────────────────────
# Cloudflare Turnstile site key (public). Set it, deploy, and only then switch CAPTCHA on in Supabase with the
# matching secret key (README §8.8): with CAPTCHA on and no key here, nobody can sign in with a password.
# Example: 0x4AAAAAAABkMYinukE8nzY
VITE_TURNSTILE_SITE_KEY=

# ── Manager account (optional) ───────────────────────────────────────
# The email that signing in as just "admin" maps to. Default: admin@oded.me
# It must match admin_email in supabase/schema.sql.
VITE_ADMIN_EMAIL=

# ── Base path (optional) ─────────────────────────────────────────────
# The path the site is served under. Default: /
# Only GitHub Pages project sites without a custom domain need /<repo>/, e.g. /oded-blog/.
# The GitHub workflow sets it for you.
VITE_BASE=
